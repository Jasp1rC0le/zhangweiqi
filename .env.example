# 仅作变量名说明，不要把真实密码或密钥提交到 Git。
DB_USERNAME=campus_ai_app
DB_PASSWORD=
JWT_SECRET=
DEEPSEEK_API_KEY=
CORS_ALLOWED_ORIGINS=https://campthink.cn
PUBLIC_WEB_URL=https://campthink.cn
AUTH_SECURE_COOKIES=true
# 仅在完成真实主体/第三方/留存期限等隐私文本审核后启用生产启动。
PRIVACY_POLICY_APPROVED=false
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=contact@campthinkhub.cn
PRIVACY_POLICY_VERSION=2026-10-27
PRIVACY_PROCESSORS_CONFIRMED=false
PRIVACY_RETENTION_CONFIRMED=false

# 启用邮箱验证和找回密码时配置，密钥仅放在服务器环境变量或密钥管理服务。
# 2026-10-04 公开 MX 指向腾讯企业邮；须在邮箱后台确认 SMTP 已启用并使用对应授权码
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=contact@campthinkhub.cn
SMTP_PASSWORD=
# 仅在邮箱服务商完成该地址验证、并配置对应 SMTP 账号后启用发信。
SMTP_FROM=contact@campthinkhub.cn
CONTACT_RECIPIENT_EMAIL=contact@campthinkhub.cn
# 访客反馈送达的学校ID。必须由运营确认；0禁用访客反馈，登录用户仍可提交。
CONTACT_SCHOOL_ID=0

# 免费版建议启动参数；金额是应用侧估算预算，不是供应商账单硬上限
SPRING_PROFILES_ACTIVE=prod,free
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_ai
AI_DAILY_TOKEN_LIMIT=20000
AI_PLATFORM_DAILY_CNY=10
AI_PLATFORM_MONTHLY_CNY=200
AI_MAX_INPUT_BYTES=48000
AI_MAX_CONCURRENT=4
# 填实际具有 ADMIN 角色的运营账号 ID；0 禁止任何账号查看全站成本
AI_COST_ADMIN_USER_ID=0
# 以下 DeepSeek 单价来自 2026-10-04 官网：高峰/未命中缓存，保守估算
DEEPSEEK_FLASH_INPUT_CNY_PER_MILLION=2
DEEPSEEK_FLASH_OUTPUT_CNY_PER_MILLION=8
DEEPSEEK_PRO_INPUT_CNY_PER_MILLION=9
DEEPSEEK_PRO_OUTPUT_CNY_PER_MILLION=27
# 不猜单价：启用相应 Key 前须核对模型、币种、上下文阶梯、缓存写入等费用
KIMI_API_KEY=
KIMI_INPUT_CNY_PER_MILLION=
KIMI_OUTPUT_CNY_PER_MILLION=
GLM_API_KEY=
GLM_INPUT_CNY_PER_MILLION=
GLM_OUTPUT_CNY_PER_MILLION=
# 受控单次调停课：需另行审核增量迁移，并开启教学/身份审核/名单/学籍；默认关闭。
APP_TEACHING_LESSON_CHANGE_ENABLED=false
