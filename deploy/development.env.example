# 本机开发模板。复制到仓库根目录 .env 后填写，仅加载自己的受控文件。
# 不要连接生产数据库，不要把实际密码或模型 Key 提交到 Git。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_ai_dev
DB_USERNAME=campus_ai_dev
DB_PASSWORD=
# 至少 32 字节随机数据的 Base64 编码。
JWT_SECRET=
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
AUTH_SECURE_COOKIES=false
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
WEB_SEARCH_ENABLED=false
KNOWLEDGE_SEMANTIC_ENABLED=false
KNOWLEDGE_RERANK_ENABLED=false
CAREER_SEED_OFFICIAL_CANDIDATES=false
KNOWLEDGE_SEED_OFFICIAL_SCHOOL=false
CONTACT_SCHOOL_ID=0
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
