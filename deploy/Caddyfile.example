# Apply only after filing is approved and DNS points to the actual server.
# Caddy obtains and renews the TLS certificate; ports 80 and 443 must be reachable.
campthink.cn {
    root * /srv/campus-ai-web
    encode zstd gzip

    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    header Strict-Transport-Security "max-age=31536000"
    header X-Frame-Options DENY
    header Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Same-origin production build. Re-evaluate explicit origins before adding external assets or APIs.
    header Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"

    # Hide dotfiles and development fixtures even if mistakenly copied into the web root.
    @private path /.git /.git/* /.env* /design /design/* /design-review.html
    # Exclusive handler is required: a later respond matcher would see /index.html
    # after the SPA fallback rewrites the original private path.
    handle @private {
        respond 404
    }

    handle /api/* {
        request_body {
            max_size 40MB
        }
        reverse_proxy 127.0.0.1:8080 {
            # Single local proxy only: never trust client-supplied forwarding headers.
            header_up -Forwarded
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        @shell not path /assets/*
        header @shell Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
